# CampusConnect Environment Configuration

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Cloud Configuration (Optional - Demo mode works locally without it)
# Project URL & Public Anon Key from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Explicit Demo Mode Switch (Defaults to true when credentials are absent)
NEXT_PUBLIC_DEMO_MODE=true
