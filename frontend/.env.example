# CampusConnect Environment Configuration

# 1. Clerk Authentication Configuration (Application ID: app_3L7XtzGjCoAeeiA8Wx7bFbkJ4TF)
# Retrieve keys from Clerk Dashboard > API Keys: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/redirect

# 2. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# 3. Supabase Cloud Configuration (Optional - Demo mode works locally without it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Explicit Demo Mode Switch (Defaults to true when credentials are absent)
NEXT_PUBLIC_DEMO_MODE=true
